  "components": {
    "schemas": {
      "AuditReadDto": {
        "required": [
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "createdAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangePasswordDto": {
        "required": [
