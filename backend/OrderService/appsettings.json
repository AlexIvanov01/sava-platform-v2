{
    "Kestrel": {
        "Endpoints": {
            "Grpc": {
                "Protocols": "Http2",
                "Url": "http://*:666"
            },
            "webApi": {
                "Protocols": "Http1",
                "Url": "http://*:80"
            }
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "WriteTo": [ { "Name": "Console" } ]
    },
    "AllowedHosts": "*",
    "RabbitMQPort": "5672",
    "Messaging": {
        "SweepIntervalMinutes": 15,
        "BatchSize": 50,
        "MaxAttempts": 10,
        "RetryBaseDelaySeconds": 30,
        "RetryMaxDelaySeconds": 300,
        "PublishTimeoutSeconds": 10,
        "RetentionDays": 7,
        "CleanupHourUtc": 1
    }
}
