    // Authorization lives here, not in the services. Ocelot's RouteClaimsRequirement matches a single
    // exact value, so "Administrator or User" is expressed as "any valid token" (AuthenticationOptions
    // without a claims requirement). Reads need a valid token; anything that changes data needs
    // Role=Administrator, so routes that mix read and write methods are split in two.
    "Routes": [
        // Authentication Service
        {
            "UpstreamPathTemplate": "/api/Account",
            "UpstreamHttpMethod": [ "Post" ],
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "authentication-clusterip-srv",
                    "Port": 80
                }
            ],
            "DownstreamPathTemplate": "/api/Account"
