  "components": {
    "schemas": {
      "AuditReadDto": {
        "required": [
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "createdAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BatchCreateDto": {
        "required": [
          "lot",
          "quantity",
          "purchasePrice",
          "sellPrice",
          "expirationDate",
          "location"
        ],
        "type": "object",
        "properties": {
          "lot": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "purchasePrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "sellPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "expirationDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BatchReadDto": {
        "required": [
          "id",
          "lot",
          "quantity",
          "purchasePrice",
          "sellPrice",
          "expirationDate",
          "location",
          "audit"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lot": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
