{
    "Kestrel": {
        "Endpoints": {
            "Grpc": {
                "Protocols": "Http2",
                "Url": "http://*:666"
            },
            "webApi": {
                "Protocols": "Http1",
                "Url": "http://*:80"
            }
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "WriteTo": [ { "Name": "Console" } ]
    },
    "AllowedHosts": "*",
    "RabbitMQPort": "5672",
    "GrpcSyncIntervalInMinutes": "1"
}
