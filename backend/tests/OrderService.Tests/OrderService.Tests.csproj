<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\OrderService\OrderService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- The service gets 10.0.13 only via the private EF Tools package; align it to avoid MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Testcontainers.MySql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development seed data of all three services, used to test the order seeding. -->
    <None
      Include="..\..\CustomerService\dummy_data.json"
      Link="SeedData\customers.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\InventoryService\dummy_data.json"
      Link="SeedData\products.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\OrderService\dummy_data.json"
      Link="SeedData\orders.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
